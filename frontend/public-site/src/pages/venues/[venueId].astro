---
import GameXLayout from "../../layouts/GameXLayout.astro";

const { venueId } = Astro.params;

const response = await fetch(
  `http://localhost:8007/v1/venues/${venueId}`
);

if (!response.ok) {
  throw new Error("Venue not found");
}

const venue = await response.json();
---

<GameXLayout title={`${venue.name} - GameX`}>

  <section class="page">

    <div class="container">

      <a href="/venues" class="back">
        ← Back to venues
      </a>

      <div class="venue">

        <div class="venue-image">
          🏟️
        </div>

        <div class="venue-info">

          <p class="sport">
            {venue.sport.toUpperCase()}
          </p>

          <h1>{venue.name}</h1>

          <p class="address">
            📍 {venue.address}
          </p>

          <p class="description">
            {venue.description}
          </p>

          <div class="booking-box">

            <div>
              <span>Starting from</span>

              <strong>
                ₹{venue.price_per_hour}
              </strong>

              <span>/ hour</span>
            </div>

            <a
              href={`/booking?venue=${venue.id}`}
              class="button"
            >
              Book Now
            </a>

          </div>

        </div>

      </div>

    </div>

  </section>

</GameXLayout>

<style>
  .page {
    padding: 70px 0;
  }

  .container {
    width: min(1100px, 92%);
    margin: auto;
  }

  .back {
    color: #374151;
    text-decoration: none;
  }

  .venue {
    margin-top: 35px;
    background: white;
    border-radius: 18px;
    overflow: hidden;
  }

  .venue-image {
    height: 350px;
    background: #e5e7eb;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 100px;
  }

  .venue-info {
    padding: 35px;
  }

  .sport {
    font-weight: 700;
    color: #6b7280;
  }

  h1 {
    font-size: 48px;
  }

  .address,
  .description {
    color: #6b7280;
    line-height: 1.7;
  }

  .booking-box {
    margin-top: 35px;
    padding: 25px;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .booking-box strong {
    font-size: 28px;
    margin: 0 5px;
  }

  .button {
    background: #111827;
    color: white;
    padding: 14px 25px;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 700;
  }
</style>