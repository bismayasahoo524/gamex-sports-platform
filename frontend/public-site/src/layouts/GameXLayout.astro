---
interface Props {
  title?: string;
}

const { title = "GameX" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="GameX - Discover sports venues and competitions."
    />
    <title>{title}</title>
  </head>

  <body>
    <header class="navbar">
      <div class="container navbar-inner">
        <a href="/" class="logo">GAMEX</a>

        <nav>
          <a href="/">Home</a>
          <a href="/venues">Venues</a>
          <a href="/events">Competitions</a>
          <a href="/account">Account</a>
        </nav>

        <a href="/account" class="login-button">
          Login
        </a>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <div class="container">
        <strong>GAMEX</strong>
        <p>Play. Compete. Win.</p>
      </div>
    </footer>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    margin: 0;
    font-family: Arial, Helvetica, sans-serif;
    background: #f7f8fa;
    color: #111827;
  }

  .container {
    width: min(1200px, 92%);
    margin: 0 auto;
  }

  .navbar {
    background: white;
    border-bottom: 1px solid #e5e7eb;
  }

  .navbar-inner {
    height: 72px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
  }

  .logo {
    font-size: 24px;
    font-weight: 800;
    text-decoration: none;
    color: #111827;
  }

  nav {
    display: flex;
    gap: 24px;
  }

  nav a {
    text-decoration: none;
    color: #374151;
    font-weight: 500;
  }

  nav a:hover {
    color: #111827;
  }

  .login-button {
    text-decoration: none;
    background: #111827;
    color: white;
    padding: 10px 18px;
    border-radius: 8px;
  }

  footer {
    margin-top: 80px;
    padding: 40px 0;
    background: #111827;
    color: white;
  }
</style>