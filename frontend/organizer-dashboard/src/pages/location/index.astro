---
import GameXLayout from "../../layouts/GameXLayout.astro";

const locations = [
  "Bhubaneswar",
  "Cuttack",
  "Puri",
  "Rourkela",
  "Kolkata",
  "Bengaluru",
  "Hyderabad",
  "Mumbai",
  "Delhi"
];
---

<GameXLayout title="Select Location - GameX">

  <section class="page">
    <div class="container">

      <a href="/" class="back">← Back</a>

      <h1>Where do you want to play?</h1>

      <p>
        Select your city to discover nearby sports venues
        and competitions.
      </p>

      <div class="search-box">
        <input
          type="text"
          id="locationSearch"
          placeholder="Search location..."
        />
      </div>

      <div class="location-grid" id="locationGrid">

        {locations.map((location) => (
          <button
            class="location-item"
            data-location={location}
          >
            <span>📍</span>
            {location}
          </button>
        ))}

      </div>

    </div>
  </section>

</GameXLayout>

<script>
  const buttons = document.querySelectorAll(".location-item");
  const search = document.querySelector("#locationSearch");

  buttons.forEach((button) => {
    button.addEventListener("click", () => {
      const location = button.getAttribute("data-location");

      if (!location) return;

      localStorage.setItem("gamex_location", location);

      window.location.href =
        `/sports?location=${encodeURIComponent(location)}`;
    });
  });

  search?.addEventListener("input", () => {
    const value = (search as HTMLInputElement).value.toLowerCase();

    buttons.forEach((button) => {
      const location =
        button.getAttribute("data-location")?.toLowerCase() ?? "";

      (button as HTMLElement).style.display =
        location.includes(value) ? "flex" : "none";
    });
  });
</script>

<style>
  .page {
    padding: 70px 0;
  }

  .container {
    width: min(1000px, 92%);
    margin: auto;
  }

  .back {
    color: #374151;
    text-decoration: none;
  }

  h1 {
    font-size: 48px;
    margin: 30px 0 10px;
  }

  p {
    color: #6b7280;
  }

  .search-box {
    margin: 35px 0;
  }

  input {
    width: 100%;
    padding: 16px;
    border: 1px solid #d1d5db;
    border-radius: 10px;
    font-size: 16px;
  }

  .location-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 15px;
  }

  .location-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 20px;
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 10px;
    cursor: pointer;
    font-size: 16px;
    text-align: left;
  }

  .location-item:hover {
    border-color: #111827;
  }

  @media (max-width: 700px) {
    .location-grid {
      grid-template-columns: 1fr;
    }

    h1 {
      font-size: 36px;
    }
  }
</style>